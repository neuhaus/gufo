# Environment for gufo-rank1@.service on the rank 1 (worker) host.
# Install as ~/.config/gufo/worker.env
# Plus one per-quantization file, e.g. ~/.config/gufo/q8.env
# (see quant.env.example).

# address of the rank 0 (head) host as seen from this host
# (TP bootstrap + control channel)
GUFO_HEAD_HOST=192.168.100.1

# podman image providing the ROCm runtime for the gufo container
GUFO_IMAGE=localhost/gufo-tp2-dev:7.2.3

# MTP sidecar model (shared by both ranks)
GUFO_MTP_MODEL=/opt/models/qwen3.8-flash-next/MTP/mtp-Qwen3.8-Flash-Next-shared-Q8_0.gguf

# scheduler sizing; must match the head host's head.env
# (the TP control handshake rejects differing values)
GUFO_SESSIONS=8
GUFO_MAX_PENDING=8
