# Environment for gufo@.service on the rank 0 (head) host, which holds the
# whole configuration: it hands the shared settings to the rank 1 host.
# Install as ~/.config/gufo/head.env

# ssh name of the rank 1 (worker) host
GUFO_PEER=box2

# Address the worker connects to (TP bootstrap and control), on this host's
# RDMA link. Found automatically when this host has one RDMA netdev; else
# name the netdev, or give the address.
#GUFO_TP_NETDEV=ib0
#GUFO_TP_ADDR=192.0.2.1

# RDMA device for the TP link on both hosts, when a host has several (for
# example InfiniBand and USB4). The address above only carries TCP (bootstrap,
# and each model call's short control message); with a device set and no
# address or netdev given, it is the one the peer's ssh connection comes from,
# typically the LAN. With InfiniBand also plugged in, GUFO_TP_NETDEV=<its IPoIB netdev> keeps
# that traffic on IPoIB while the exchanges use USB4. A device whose libibverbs provider is not in the
# image (USB4 rails of thunderbolt-ibverbs: usb4_rdma) also needs the
# provider's RDMAV_DRIVERS path prefix, present on both hosts; its directory
# is mounted into the containers.
#GUFO_TP_RDMA_DEVICE=usb4_rdma0
#GUFO_RDMA_DRIVERS=/opt/thunderbolt-ibverbs/libusb4_rdma

# gufo checkout with a built build/gpu-tp2/gufo, and the cache directory
# (continuation snapshots under gufo-tp2/<quant>, the model files' identity
# digests under gufo). Both default to each host's own ~/git/gufo and
# ~/.cache; a value set here applies to both hosts, so it must be an
# absolute path that exists on both.
#GUFO_CHECKOUT=/srv/gufo
#GUFO_CACHE_DIR=/srv/gufo-cache

# podman image providing the ROCm runtime for the gufo container
GUFO_IMAGE=localhost/gufo-tp2-dev:7.2.3

# HTTP listen address / port of the rank 0 server
GUFO_HOST=0.0.0.0
GUFO_PORT=8000

# Model directory, the same on both hosts and mounted read-only at the same
# path into the containers (default /opt/models). The model paths below are
# relative to it.
#GUFO_MODEL_DIR=/opt/models

# Target model per quantization. The unit's instance name selects one:
# gufo@q8 uses GUFO_MODEL_Q8.
GUFO_MODEL_Q8=qwen3.8-flash-next/Q8_0/Qwen3.8-Flash-Next-Q8_0-00001-of-00006.gguf
GUFO_MODEL_Q4=qwen3.8-flash-next/UD-Q4_K_XL/Qwen3.8-Flash-Next-UD-Q4_K_XL-00001-of-00004.gguf

# MTP sidecar model (shared by both ranks)
GUFO_MODEL_MTP=qwen3.8-flash-next/MTP/mtp-Qwen3.8-Flash-Next-shared-Q8_0.gguf

# Model ID of the public API (default qwen3.8-flash-next)
#GUFO_SERVED_MODEL_NAME=qwen3.8-flash-next

# scheduler sizing, used by both ranks
GUFO_SESSIONS=8
GUFO_MAX_PENDING=8

# disk-cache budget per rank in bytes (default 64 GiB), under
# $GUFO_CACHE_DIR/gufo-tp2/<quant> on each host
#GUFO_CACHE_DISK_BYTES=68719476736
