# User unit for the rank 0 (serving) host of a two-host gufo TP=2 server.
#
# The instance name is the quantization (q4, q8, ...):
#
#   systemctl --user start gufo@q8
#
# Brings up the rank 1 worker on the peer host first (GUFO_PEER from
# ~/.config/gufo/head.env), then the rank 0 server in the foreground;
# stopping tears both down. The rank container runs via "podman run --rm"
# (no -d): systemd owns the process and the restart policy, and the
# container output is tagged with this unit in the journal.
#
# Configuration files (see the *.example files in this directory):
#   ~/.config/gufo/head.env   host settings for the rank 0 host
#   ~/.config/gufo/<quant>.env  per-quantization settings (GUFO_MODEL);
#                               a missing file fails the start cleanly
#   ~/.config/gufo.token  shared control token (both hosts)
#
# If another local user unit claims the GPU, add a drop-in
# (gufo@.service.d/local.conf) with Conflicts=<unit>.
[Unit]
Description=Gufo TP=2 two-host LLM server, %i (rank 0)

[Service]
Type=exec
Restart=on-failure
RestartSec=5
TimeoutStopSec=5min
EnvironmentFile=%h/.config/gufo/head.env
EnvironmentFile=%h/.config/gufo/%i.env
ExecStartPre=/bin/sh -c 'ssh -o ConnectTimeout=10 $GUFO_PEER systemctl --user stop gufo-rank1@*.service || true'
ExecStartPre=/bin/sh -c 'ssh -o ConnectTimeout=10 $GUFO_PEER systemctl --user start gufo-rank1@%i.service || true'
ExecStart=/bin/sh -c 'exec podman run --rm --log-driver journald --security-opt label=disable \
  --userns keep-id:uid=1000,gid=1000 \
  --device /dev/kfd --device /dev/dri \
  --device /dev/infiniband/uverbs0 --device /dev/infiniband/rdma_cm \
  --group-add keep-groups --ulimit memlock=-1 --network host \
  -v "$HOME/git/gufo:/workspace/gufo:ro" -v /opt/models:/opt/models:ro \
  -w /workspace/gufo $GUFO_IMAGE build/gpu-tp2/gufo serve llm \
  --model $GUFO_MODEL \
  --speculative mtp --mtp-model $GUFO_MTP_MODEL \
  --draft-tokens 7 \
  --sessions $GUFO_SESSIONS --max-pending $GUFO_MAX_PENDING \
  --served-model-name qwen3.8-flash-next \
  --tp-world-size 2 --tp-rank 0 \
  --host $GUFO_HOST --port $GUFO_PORT \
  --tp-bootstrap-port 18515 --tp-control-port 18516 \
  --tp-control-token "$(cat "$HOME/.config/gufo.token")"'
ExecStopPost=/bin/sh -c 'ssh -o ConnectTimeout=10 $GUFO_PEER systemctl --user stop gufo-rank1@%i.service || true'
